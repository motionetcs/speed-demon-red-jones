--- /dev/null
+++ b/track-a/method.hpp
@@ -0,0 +1,20 @@
+#pragma once
+#include <bit>
+#include <cstdint>
+#include <cstring>
+#include <stdexcept>
+
+// The legal method and its separator fit in eight bytes. No partial word is loaded.
+inline const char* after_method(const char* p, const char* end) {
+#if defined(__BYTE_ORDER__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__ && !defined(METHOD_FORCE_SCALAR)
+    if (end - p >= 8) {
+        uint64_t word; std::memcpy(&word, p, 8);
+        uint64_t x = word ^ 0x2020202020202020ULL;
+        uint64_t mask = (x - 0x0101010101010101ULL) & ~x & 0x8080808080808080ULL;
+        if (mask) return p + std::countr_zero(mask) / 8 + 1;
+    }
+#endif
+    const char* space = static_cast<const char*>(std::memchr(p, ' ', end - p));
+    if (!space) throw std::runtime_error("missing method separator");
+    return space + 1;
+}
