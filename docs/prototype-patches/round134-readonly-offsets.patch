+#ifndef OFFSET_BLOCK_SHIFT
+#define OFFSET_BLOCK_SHIFT 12
+#endif
+// Read-only prefix values use a block base and exact16-bit deltas only when
+// every delta fits. A single wide block keeps the entire full32-bit vector.
+struct ReadOffsets {
+    static constexpr unsigned shift=OFFSET_BLOCK_SHIFT;
+    static_assert(shift>=1&&shift<=30);
+    static constexpr size_t block_size=size_t(1)<<shift;
+    std::vector<uint32_t> base,wide;
+    std::vector<uint16_t> small;
+    explicit ReadOffsets(std::vector<uint32_t>&& values){
+        size_t count=values.size();
+        for(size_t begin=0;begin<count;begin+=block_size){
+            size_t end=std::min(count-1,begin+block_size-1);
+            if(values[end]-values[begin]>UINT16_MAX){wide=std::move(values);return;}
+        }
+        base.resize((count+block_size-1)/block_size);small.resize(count);
+        for(size_t i=0;i<count;++i){
+            if((i&(block_size-1))==0)base[i>>shift]=values[i];
+            small[i]=static_cast<uint16_t>(values[i]-base[i>>shift]);
+        }
+        std::vector<uint32_t>().swap(values);
+    }
+    uint32_t operator[](size_t node)const{return small.empty()?wide[node]:base[node>>shift]+small[node];}
+    void prefetch(size_t node)const{if(small.empty())__builtin_prefetch(&wide[node],0,1);else __builtin_prefetch(&small[node],0,1);}
+};
