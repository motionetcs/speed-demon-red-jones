+// A single ordinary file mapping receives disjoint exact-size hour slices.
+struct OutputMapping {
+    int fd=-1;
+    char* data=static_cast<char*>(MAP_FAILED);
+    size_t size;
+    OutputMapping(const std::filesystem::path& path,size_t length):size(length) {
+        if(length>static_cast<uintmax_t>(std::numeric_limits<off_t>::max()))throw std::runtime_error("summary file size overflow");
+        fd=open(path.c_str(),O_RDWR|O_CREAT|O_TRUNC,0666);
+        if(fd<0)throw std::runtime_error("cannot open summary.txt");
+        if(ftruncate(fd,static_cast<off_t>(size))!=0){close(fd);fd=-1;throw std::runtime_error("cannot size summary.txt");}
+        if(size){
+            void* address=mmap(nullptr,size,PROT_READ|PROT_WRITE,MAP_SHARED,fd,0);
+            if(address==MAP_FAILED){close(fd);fd=-1;throw std::runtime_error("cannot map summary.txt");}
+            data=static_cast<char*>(address);
         }
     }
