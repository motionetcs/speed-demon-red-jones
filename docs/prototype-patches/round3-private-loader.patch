--- /dev/null
+++ b/track-d/load_cursors.hpp
@@ -0,0 +1,55 @@
+#pragma once
+#include <cstdint>
+#include <vector>
+#include <unordered_map>
+
+// Small degrees are common, but overflow never truncates a graph degree.
+struct Degrees {
+    std::vector<uint8_t> small;
+    std::unordered_map<uint32_t, uint32_t> extra;
+    explicit Degrees(size_t nodes) : small(nodes) {}
+    void add(uint32_t node) { if (small[node] != UINT8_MAX) ++small[node]; else ++extra[node]; }
+    uint32_t get(uint32_t node) const {
+        if (small[node] != UINT8_MAX) return small[node];
+        auto i = extra.find(node); return UINT8_MAX + (i == extra.end() ? 0 : i->second);
+    }
+    void release() { std::vector<uint8_t>().swap(small); std::unordered_map<uint32_t,uint32_t>().swap(extra); }
+};
+
+// Relative offsets fit in16 bits only in blocks with at most65535 total edges.
+// Wider blocks retain complete32-bit absolute cursors.
+struct CursorLayout {
+    static constexpr uint32_t shift = 12, block_size = 1U << shift;
+    std::vector<uint32_t> base, wide_index;
+    size_t wide_blocks = 0;
+    explicit CursorLayout(const std::vector<uint32_t>& starts) {
+        size_t nodes = starts.size() - 1, blocks = (nodes + block_size - 1) / block_size;
+        base.resize(blocks); wide_index.resize(blocks, UINT32_MAX);
+        for (size_t block = 0; block < blocks; ++block) {
+            size_t begin = block * block_size, end = std::min(nodes, begin + block_size);
+            base[block] = starts[begin];
+            if (starts[end] - starts[begin] > UINT16_MAX) wide_index[block] = static_cast<uint32_t>(wide_blocks++);
+        }
+    }
+};
+struct WriteCursor {
+    const CursorLayout* layout;
+    std::vector<uint16_t> small;
+    std::vector<uint32_t> wide;
+    WriteCursor(const CursorLayout& l, std::vector<uint32_t>& starts, const Degrees& counts) : layout(&l),
+        small(starts.size() - 1), wide(l.wide_blocks * CursorLayout::block_size) {
+        for (size_t node = 0; node < small.size(); ++node) {
+            size_t block = node >> CursorLayout::shift;
+            uint32_t index = l.wide_index[block];
+            if (index == UINT32_MAX) small[node] = static_cast<uint16_t>(starts[node] - l.base[block]);
+            else wide[size_t(index) * CursorLayout::block_size + (node & (CursorLayout::block_size - 1))] = starts[node];
+            starts[node] += counts.get(static_cast<uint32_t>(node));
+        }
+    }
+    uint32_t take(uint32_t node) {
+        size_t block = node >> CursorLayout::shift;
+        uint32_t index = layout->wide_index[block];
+        if (index == UINT32_MAX) return layout->base[block] + small[node]++;
+        return wide[size_t(index) * CursorLayout::block_size + (node & (CursorLayout::block_size - 1))]++;
+    }
+};
