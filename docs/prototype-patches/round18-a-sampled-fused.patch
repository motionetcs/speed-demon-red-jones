+static uint64_t endpoint_hash(std::string_view key) {
+    if (key.size() < 8) return std::hash<std::string_view>{}(key);
+    uint64_t a, b, c;
+    std::memcpy(&a, key.data(), 8); std::memcpy(&b, key.data() + key.size() - 8, 8);
+    std::memcpy(&c, key.data() + (key.size() - 8) / 2, 8);
+    uint64_t h = a * 0x9e3779b97f4a7c15ULL ^ std::rotr(b, 23) ^ c * 0xc2b2ae3d27d4eb4fULL ^ key.size();
+    return h ^ (h >> 32);
+}
