+struct EdgeReader {
+    std::array<Scanner,GRAPH_STREAMS> inputs{};
+    EdgeReader(const std::vector<const char*>& bounds,unsigned worker){
+        for(unsigned lane=0;lane<GRAPH_STREAMS;++lane){unsigned part=worker*GRAPH_STREAMS+lane;inputs[lane]={bounds[part],bounds[part+1]};}
+    }
+    template<class Row,class Hint> size_t read(std::array<Row,16>& rows,Hint hint){
+        size_t count=0;
+        for(unsigned step=0;step<16;step+=GRAPH_STREAMS){
+            std::array<unsigned,GRAPH_STREAMS> active;unsigned live=0;
+            for(unsigned lane=0;lane<GRAPH_STREAMS;++lane)if(inputs[lane].more()){active[live]=lane;rows[count+live].u=inputs[lane].number();++live;}
+            if(!live)break;
+            for(unsigned i=0;i<live;++i)rows[count+i].v=inputs[active[i]].number();
+            for(unsigned i=0;i<live;++i){auto& row=rows[count+i];row.value=inputs[active[i]].number();hint(row);}
+            count+=live;
+        }
+        return count;
+    }
+};
