+inline uint32_t cache_hash(std::string_view value) {
+    if (value.size() < 4) return static_cast<uint32_t>(std::hash<std::string_view>{}(value));
+    uint32_t a, b, c;
+    std::memcpy(&a, value.data(), 4); std::memcpy(&b, value.data() + (value.size() - 4) / 2, 4);
+    std::memcpy(&c, value.data() + value.size() - 4, 4);
+    uint32_t hash = (a ^ std::rotl(b, 11) ^ std::rotl(c, 23) ^ static_cast<uint32_t>(value.size())) * 0x9e3779b1U;
+    return hash ^ (hash >> 16);
+}
 
