diff --git a/track-c/membership.hpp b/track-c/membership.hpp
--- /dev/null
+++ b/track-c/membership.hpp
@@ -0,0 +1,29 @@
+#pragma once
+#include <array>
+#include <cstdint>
+#include <vector>
+
+// Seven country IDs inline; larger exact sets use a private 256-bit bitmap.
+struct Membership {
+    std::vector<uint64_t> slots;
+    std::vector<std::array<uint64_t,4>> overflow;
+    static constexpr uint64_t low = 0x00ffffffffffffffULL, ones = 0x0001010101010101ULL, high = 0x0080808080808080ULL;
+    void add(size_t slot, size_t country) {
+        uint64_t value = slots[slot], count = value >> 56;
+        if (count == 255) { overflow[uint32_t(value)][country / 64] |= uint64_t(1) << (country % 64); return; }
+        uint64_t encoded = country + 1, different = (value ^ (ones * encoded)) & low;
+        if ((different - ones) & ~different & high) return;
+        if (count < 7) slots[slot] = (value & low) | (encoded << (count * 8)) | ((count + 1) << 56);
+        else {
+            std::array<uint64_t,4> bits{};
+            for (unsigned i = 0; i < 7; ++i) { size_t id = uint8_t(value >> (i * 8)) - 1; bits[id / 64] |= uint64_t(1) << (id % 64); }
+            bits[country / 64] |= uint64_t(1) << (country % 64);
+            slots[slot] = (uint64_t(255) << 56) | overflow.size(); overflow.push_back(bits);
+        }
+    }
+    void merge(size_t slot, std::array<uint64_t,4>& bits) const {
+        uint64_t value = slots[slot];
+        if ((value >> 56) == 255) { const auto& other = overflow[uint32_t(value)]; for (unsigned i = 0; i < 4; ++i) bits[i] |= other[i]; }
+        else for (value &= low; value; value >>= 8) { size_t id = uint8_t(value) - 1; bits[id / 64] |= uint64_t(1) << (id % 64); }
+    }
+};
