@@ -28,3 +28,20 @@
 #endif
     return static_cast<const char*>(std::memchr(p, '"', end - p));
 }
+
+// Each quote lane is one bit on SSE/scalar and four identical bits on NEON.
+#if defined(__ARM_NEON) && !defined(__SSE2__) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+inline constexpr unsigned quote_lane_bits = 4;
+#else
+inline constexpr unsigned quote_lane_bits = 1;
+#endif
+inline uint64_t quote_block_mask(const char* p) {
+#if defined(__SSE2__)
+    return static_cast<uint32_t>(_mm_movemask_epi8(_mm_cmpeq_epi8(_mm_loadu_si128(reinterpret_cast<const __m128i*>(p)), _mm_set1_epi8('"'))));
+#elif defined(__ARM_NEON) && __BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__
+    auto equal = vceqq_u8(vld1q_u8(reinterpret_cast<const uint8_t*>(p)), vdupq_n_u8('"'));
+    return vget_lane_u64(vreinterpret_u64_u8(vshrn_n_u16(vreinterpretq_u16_u8(equal), 4)), 0);
+#else
+    uint64_t bits = 0; for (unsigned i=0;i<16;++i) bits |= uint64_t(p[i]=='"') << i; return bits;
+#endif
+}
