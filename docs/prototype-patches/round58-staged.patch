+++ b/track-d/staged_edges.hpp
@@ -0,0 +1,45 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <new>
+#include <vector>
+#include <sys/mman.h>
+
+// For graphs whose node IDs fit21 bits. Weight escapes retain all32 bits.
+// Blocks are process-owned anonymous mappings and are unmapped before queries.
+struct StagedEdges {
+    static constexpr size_t block_bits=16, block_size=size_t(1)<<block_bits;
+    static constexpr uint32_t node_mask=(1U<<21)-1, escape=(1U<<22)-1;
+    struct Block {
+        uint64_t* data;
+        Block() {
+            void* p=mmap(nullptr,block_size*sizeof(uint64_t),PROT_READ|PROT_WRITE,MAP_PRIVATE|MAP_ANONYMOUS,-1,0);
+            if(p==MAP_FAILED) throw std::bad_alloc();
+            data=static_cast<uint64_t*>(p);
+        }
+        ~Block(){munmap(data,block_size*sizeof(uint64_t));}
+        Block(const Block&)=delete;
+        Block& operator=(const Block&)=delete;
+    };
+    std::vector<std::unique_ptr<Block>> blocks;
+    std::vector<uint32_t> wide;
+    size_t count=0;
+    void push(uint32_t u,uint32_t v,uint32_t weight) {
+        size_t offset=count&(block_size-1);
+        if(!offset)blocks.emplace_back(std::make_unique<Block>());
+        blocks.back()->data[offset]=uint64_t(u)|(uint64_t(v)<<21)|(uint64_t(std::min(weight,escape))<<42);
+        if(weight>=escape)wide.push_back(weight);
+        ++count;
+    }
+    struct Reader {
+        const StagedEdges& rows;
+        size_t position=0, escaped=0;
+        bool more()const{return position<rows.count;}
+        void next(uint32_t& u,uint32_t& v,uint32_t& weight) {
+            uint64_t row=rows.blocks[position>>block_bits]->data[position&(block_size-1)];++position;
+            u=uint32_t(row)&node_mask;v=uint32_t(row>>21)&node_mask;weight=uint32_t(row>>42);
+            if(weight==escape)weight=rows.wide[escaped++];
+        }
+    };
+};
