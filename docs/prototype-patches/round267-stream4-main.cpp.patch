+template<size_t Streams>
+std::array<Scanner, Streams> row_streams(const char* begin, const char* end) {
+    std::array<const char*, Streams+1> cut;
+    cut.front()=begin;cut.back()=end;
+    for(size_t i=1;i<Streams;++i){
+        const char* p=begin+(end-begin)*i/Streams;
+        if(p>begin&&p[-1]!='\n'){
+            const char* newline=static_cast<const char*>(std::memchr(p,'\n',end-p));
+            p=newline?newline+1:end;
+        }
+        cut[i]=p;
+    }
+    std::array<Scanner,Streams> inputs;
+    for(size_t i=0;i<Streams;++i)inputs[i]=Scanner{cut[i],cut[i+1]};
+    return inputs;
+}
