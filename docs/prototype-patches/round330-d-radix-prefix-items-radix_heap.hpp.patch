+    uint64_t last=0;
+    size_t count=0;
+    static constexpr uint32_t node_mask=(1U<<21)-1;
+    static uint64_t key(uint64_t item){return (item>>32)>>RADIX_BATCH_BUCKET_BITS;}
+    bool empty()const{return count==0;}
+    void clear(){for(auto& b:buckets)b.clear();for(auto& b:narrow)b.clear();last=0;count=0;}
+    bool zero_nonempty()const{return !buckets[0].empty()||!narrow[0].empty();}
