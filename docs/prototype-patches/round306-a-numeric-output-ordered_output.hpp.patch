     }
 };
+struct OutputSlice {
+    char* current;
+    char* end;
+    void text(std::string_view value){
+        if(value.size()>static_cast<size_t>(end-current))throw std::runtime_error("summary slice overflow");
+        if(!value.empty())std::memcpy(current,value.data(),value.size());
+        current+=value.size();
+    }
+    void number(uint64_t value){
+        auto result=std::to_chars(current,end,value);
