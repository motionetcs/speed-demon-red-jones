diff --git a/track-c/test.cpp b/track-c/test.cpp
--- /dev/null
+++ b/track-c/test.cpp
@@ -0,0 +1,27 @@
+#include "membership.hpp"
+#include <cassert>
+#include <random>
+#include <set>
+#include <iostream>
+int main() {
+    std::mt19937 random(765891);
+    std::array<Membership,6> workers;
+    std::array<std::array<std::set<unsigned>,64>,6> reference;
+    for(auto& worker:workers) worker.slots.resize(64);
+    for(unsigned i=0;i<100000;++i) {
+        unsigned worker=random()%6,slot=random()%64,country=random()%255;
+        workers[worker].add(slot,country); reference[worker][slot].insert(country);
+    }
+    for(unsigned slot=0;slot<64;++slot) {
+        std::array<uint64_t,4> bits{};std::set<unsigned> all;
+        for(unsigned w=0;w<6;++w) {workers[w].merge(slot,bits); all.insert(reference[w][slot].begin(),reference[w][slot].end());}
+        for(unsigned country=0;country<255;++country) assert(bool(bits[country/64]&(uint64_t(1)<<(country%64)))==bool(all.count(country)));
+    }
+    for(unsigned country=0;country<255;++country) {
+        Membership exact;exact.slots.resize(1);std::array<uint64_t,4> bits{};
+        for(unsigned i=0;i<7;++i) exact.add(0,(country+i)%255);
+        exact.add(0,country);exact.merge(0,bits);
+        for(unsigned i=0;i<255;++i) assert(bool(bits[i/64]&(uint64_t(1)<<(i%64)))==bool((i+255-country)%255<7));
+    }
+    std::cout<<"PASS compact country-set model, boundary bytes, overflow and unions\n";
+}
