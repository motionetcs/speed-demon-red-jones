 struct Count { uint32_t count = 0, errors = 0; };
+
+// The high twelve bits select the endpoint; the low nineteen order exact tags.
+static void radix_hour(std::vector<uint32_t>& values, std::vector<uint32_t>& scratch) {
+    scratch.resize(values.size());
+    for (unsigned shift : {0U, 11U, 22U}) {
+        std::array<uint32_t, 2048> positions{};
+        for (uint32_t value : values) ++positions[(value >> shift) & 2047];
+        uint32_t prefix = 0;
+        for (auto& position : positions) { uint32_t count = position; position = prefix; prefix += count; }
+        for (uint32_t value : values) scratch[positions[(value >> shift) & 2047]++] = value;
+        values.swap(scratch);
+    }
+}
 
