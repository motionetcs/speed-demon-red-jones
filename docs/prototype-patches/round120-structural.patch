+#pragma once
+#include "quote_scan.hpp"
+#include <array>
+#include <stdexcept>
+struct RawCsvField { const char* first; const char* last; size_t quotes; };
+// Concept: structural masks with carried quote parity. CSV doubles quotes;
+// there is no JSON backslash rule. No out-of-range SIMD load is permitted.
+struct RecordScanner {
+    const char* cursor; const char* end; const char* block; const char* next;
+    uint32_t quotes=0,separators=0; bool inside=false, terminated=false;
+    RecordScanner(const char* p,const char* e):cursor(p),end(e),block(p),next(p){}
+#if defined(__aarch64__) && defined(__ARM_NEON)
+    static uint32_t bits(uint8x16_t equal){
+        const uint8x8_t weights={1,2,4,8,16,32,64,128};
+        auto v=vandq_u8(equal,vcombine_u8(weights,weights));
+        return uint32_t(vaddv_u8(vget_low_u8(v)))|(uint32_t(vaddv_u8(vget_high_u8(v)))<<8);
+    }
+#endif
+    bool load(){
+        if(next==end)return false;
+        block=next; unsigned width=16; uint32_t comma=0,line=0; quotes=0;
+#if defined(__AVX2__)
+        if(end-next>=32){
+            width=32;auto v=_mm256_loadu_si256(reinterpret_cast<const __m256i*>(next));
+            quotes=uint32_t(_mm256_movemask_epi8(_mm256_cmpeq_epi8(v,_mm256_set1_epi8('"'))));
+            comma=uint32_t(_mm256_movemask_epi8(_mm256_cmpeq_epi8(v,_mm256_set1_epi8(','))));
+            line=uint32_t(_mm256_movemask_epi8(_mm256_cmpeq_epi8(v,_mm256_set1_epi8('\n'))));
+        }else
+#endif
+        if(end-next>=16){
+#if defined(__SSE2__)
+            auto v=_mm_loadu_si128(reinterpret_cast<const __m128i*>(next));
+            quotes=uint32_t(_mm_movemask_epi8(_mm_cmpeq_epi8(v,_mm_set1_epi8('"'))));
+            comma=uint32_t(_mm_movemask_epi8(_mm_cmpeq_epi8(v,_mm_set1_epi8(','))));
+            line=uint32_t(_mm_movemask_epi8(_mm_cmpeq_epi8(v,_mm_set1_epi8('\n'))));
+#elif defined(__aarch64__) && defined(__ARM_NEON)
+            auto v=vld1q_u8(reinterpret_cast<const uint8_t*>(next));
+            quotes=bits(vceqq_u8(v,vdupq_n_u8('"')));comma=bits(vceqq_u8(v,vdupq_n_u8(',')));line=bits(vceqq_u8(v,vdupq_n_u8('\n')));
+#else
+            for(unsigned i=0;i<16;++i){quotes|=uint32_t(next[i]=='"')<<i;comma|=uint32_t(next[i]==',')<<i;line|=uint32_t(next[i]=='\n')<<i;}
+#endif
+        }else{
+            width=unsigned(end-next);
+            for(unsigned i=0;i<width;++i){quotes|=uint32_t(next[i]=='"')<<i;comma|=uint32_t(next[i]==',')<<i;line|=uint32_t(next[i]=='\n')<<i;}
+        }
+        uint32_t prefix=quotes;prefix^=prefix<<1;prefix^=prefix<<2;prefix^=prefix<<4;prefix^=prefix<<8;prefix^=prefix<<16;
+        prefix^=uint32_t(0)-uint32_t(inside);inside^=(std::popcount(quotes)&1)!=0;
+        separators=(comma|line)&~prefix;next+=width;return true;
+    }
+    const char* separator(size_t& count){
+        for(;;){
+            if(separators){
+                unsigned i=std::countr_zero(separators);uint32_t through=i==31?UINT32_MAX:(uint32_t(1)<<(i+1))-1;
+                count+=std::popcount(quotes&through);quotes&=~through;separators&=separators-1;return block+i;
+            }
+            count+=std::popcount(quotes);quotes=0;
+            if(!load()){if(inside)throw std::runtime_error("unterminated CSV quotes");return end;}
+        }
+    }
+    bool record(std::array<RawCsvField,5>& fields){
+        if(cursor==end)return false;
+        for(unsigned f=0;f<5;++f){
+            size_t count=0;const char* stop=separator(count);fields[f]={cursor,stop,count};
+            if(f<4){if(stop==end||*stop!=',')throw std::runtime_error("missing CSV field");cursor=stop+1;}
+            else{if(stop!=end&&*stop!='\n')throw std::runtime_error("extra CSV field");terminated=stop!=end;cursor=stop==end?end:stop+1;}
+        }
+        return true;
+    }
+};
