+// Caller supplies a complete16-byte in-range block; one bit per exact quote.
+inline uint32_t quote_mask16(const char* p){
+#if defined(__SSE2__)
+    auto bytes=_mm_loadu_si128(reinterpret_cast<const __m128i*>(p));
+    return static_cast<uint32_t>(_mm_movemask_epi8(_mm_cmpeq_epi8(bytes,_mm_set1_epi8('"'))));
+#elif defined(__aarch64__) && defined(__ARM_NEON) && __BYTE_ORDER__==__ORDER_LITTLE_ENDIAN__
+    auto equal=vceqq_u8(vld1q_u8(reinterpret_cast<const uint8_t*>(p)),vdupq_n_u8('"'));
+    uint8x8_t weights={1,2,4,8,16,32,64,128};auto bits=vandq_u8(equal,vcombine_u8(weights,weights));
+    return uint32_t(vaddv_u8(vget_low_u8(bits)))|(uint32_t(vaddv_u8(vget_high_u8(bits)))<<8);
+#else
+    uint32_t mask=0;for(unsigned i=0;i<16;++i)mask|=uint32_t(p[i]=='"')<<i;return mask;
