+// Each worker owns growing blocks; published byte addresses never move.
+struct StringArena {
+    std::vector<std::unique_ptr<char[]>> blocks;
+    char* next = nullptr;
+    size_t remaining = 0;
+    const char* copy(std::string_view value) {
+        if (value.empty()) return "";
+        if (value.size() > remaining) {
+            size_t bytes = std::max<size_t>(65536, value.size());
+            blocks.emplace_back(new char[bytes]); next = blocks.back().get(); remaining = bytes;
+        }
+        char* result = next; std::memcpy(result, value.data(), value.size());
+        next += value.size(); remaining -= value.size(); return result;
+    }
