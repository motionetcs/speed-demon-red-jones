+++ b/track-a/record_buffer.hpp
@@ -0,0 +1,21 @@
+#pragma once
+#include <cassert>
+#include <cstddef>
+#include <cstdint>
+#include <memory>
+// At most one row per32 input bytes: every accepted row consumes at least36.
+// Allocate on first use without value-initializing unused capacity. Only the
+// written prefix is ever read; ownership transfers after parser threads join.
+struct RecordBuffer {
+    RecordBuffer()=default;
+    RecordBuffer(const RecordBuffer&)=delete;
+    RecordBuffer& operator=(const RecordBuffer&)=delete;
+    std::unique_ptr<uint32_t[]> values;
+    size_t used=0,capacity=0;
+    void allocate(size_t maximum){assert(!values&&used==0);values.reset(new uint32_t[maximum]);capacity=maximum;}
+    void append(uint32_t value){assert(used<capacity);values[used++]=value;}
+    size_t size()const{return used;}
+    const uint32_t* begin()const{return values.get();}
+    const uint32_t* end()const{return used?values.get()+used:values.get();}
+    void release(){values.reset();used=capacity=0;}
+};
