+// The high distance prefix is implicit in a radix bucket and its last key.
+// Only six small buckets with <=11 varying distance bits and 21-bit IDs pack.
+struct PrefixDistanceQueue {
+    std::array<std::vector<uint64_t>,33> buckets;
