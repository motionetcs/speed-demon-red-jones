@@ -0,0 +1,26 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <memory>
+#include <vector>
+
+struct RecordBlocks {
+    static constexpr size_t block_size = 4096;
+    std::vector<std::unique_ptr<uint32_t[]>> blocks;
+    size_t count = 0;
+    size_t size() const { return count; }
+    void push_back(uint32_t value) {
+        if (count % block_size == 0) blocks.emplace_back(new uint32_t[block_size]);
+        blocks.back()[count % block_size] = value;
+        ++count;
+    }
+    template<class Function> void each(Function function) const {
+        size_t remaining = count;
+        for (const auto& block : blocks) {
+            size_t used = std::min(remaining, block_size);
+            for (size_t i = 0; i < used; ++i) function(block[i]);
+            remaining -= used;
+        }
+    }
+    void clear() { blocks.clear(); count = 0; }
+};
